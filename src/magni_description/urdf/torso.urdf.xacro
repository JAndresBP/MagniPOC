<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Humanoid-style torso that replaces the Magni tower (waiter-robot layout).

       The whole structure is ONE rigid aluminum-extrusion weldment
       (meshes/torso_frame.stl, generated by scripts/generate_torso_frame_mesh.py):
       a 4-rail 30mm T-slot column, a shoulder crossbar with an adapter plate
       on each end, a neck post, and the serving-tray support (riser + two
       arms). The frame sits flush with the BACK of the Magni: with the frame
       centered at x=-0.25 its rear face lands at x=-0.31, the base collision
       box's rear edge.

       Frames it provides (all welded, fixed joints):
         torso_right_arm_mount : right shoulder adapter plate. Its +Z points to
                                 the robot's RIGHT side (-Y of base_link), so an
                                 arm whose first joint rotates about its base Z
                                 (like the reBot B601) hangs off the shoulder
                                 with joint1's axis normal to Magni's right
                                 side, human-style.
         torso_left_arm_mount  : mirrored left shoulder plate (+Z points +Y).
                                 Free for a second arm or accessories. NOTE: a
                                 second reBot arm needs a link/joint-name-
                                 prefixed copy of its URDF first (the vendored
                                 file has fixed names joint1..joint6).
         torso_head_mount      : top plate of the neck, +Z up, for a sensor
                                 head, screen or any other head payload.

       left_accessory: 'tray' (default) puts the tray disc on its support;
                       'none' omits the disc (the support frame is part of the
                       structural mesh and stays either way).
       head_accessory: 'screen' (default) | 'sensor_head' | 'none' - simple
                       geometric placeholders on torso_head_mount.

       Heights above the floor (base_link is 0.1 m up; frame base at z=0.16):
         shoulders 0.77, tray surface ~0.87, head mount ~0.91. -->

  <xacro:include filename="$(find magni_description)/urdf/inertial.xacro"/>

  <xacro:macro name="magni_torso" params="parent:='base_link' left_accessory:='tray' head_accessory:='screen'">

    <!-- The whole extrusion frame, torso + tray support, as a single link -->
    <link name="torso_frame">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://magni_description/meshes/torso_frame.stl"/>
        </geometry>
        <material name="torso_aluminum">
          <color rgba="0.77 0.78 0.80 1"/>
        </material>
      </visual>
      <!-- column envelope -->
      <collision>
        <origin xyz="0 0 0.2625" rpy="0 0 0"/>
        <geometry>
          <box size="0.12 0.27 0.525"/>
        </geometry>
      </collision>
      <!-- shoulder crossbar incl. adapter plates -->
      <collision>
        <origin xyz="0 0 0.51" rpy="0 0 0"/>
        <geometry>
          <box size="0.10 0.364 0.10"/>
        </geometry>
      </collision>
      <!-- neck -->
      <collision>
        <origin xyz="0 0 0.5825" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.03 0.115"/>
        </geometry>
      </collision>
      <!-- tray support Y-arm -->
      <collision>
        <origin xyz="0 0.2275 0.5775" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.175 0.03"/>
        </geometry>
      </collision>
      <!-- tray support X-arm -->
      <collision>
        <origin xyz="0.075 0.30 0.5775" rpy="0 0 0"/>
        <geometry>
          <box size="0.18 0.03 0.03"/>
        </geometry>
      </collision>
      <xacro:box_inertial_with_origin x="0.12" y="0.27" z="0.65" mass="3.8">
        <origin xyz="0 0 0.30" rpy="0 0 0"/>
      </xacro:box_inertial_with_origin>
    </link>
    <joint name="torso_frame_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="torso_frame"/>
      <!-- On the Magni deck, flush with the back of the base -->
      <origin xyz="-0.25 0 0.16" rpy="0 0 0"/>
    </joint>

    <!-- Right shoulder: outer face of the right adapter plate. +Z of this
         frame points to the robot's right (-Y), so an arm base bolted flat
         onto it gets its first joint axis normal to the right side of the
         Magni. roll=+90deg maps Z to -Y and keeps X pointing forward, so the
         arm's zero pose reaches ahead. -->
    <link name="torso_right_arm_mount"/>
    <joint name="torso_right_arm_mount_joint" type="fixed">
      <parent link="torso_frame"/>
      <child link="torso_right_arm_mount"/>
      <origin xyz="0 -0.182 0.51" rpy="${pi/2} 0 0"/>
    </joint>

    <!-- Left shoulder plate, mirrored (+Z points to +Y) -->
    <link name="torso_left_arm_mount"/>
    <joint name="torso_left_arm_mount_joint" type="fixed">
      <parent link="torso_frame"/>
      <child link="torso_left_arm_mount"/>
      <origin xyz="0 0.182 0.51" rpy="${-pi/2} 0 0"/>
    </joint>

    <!-- Head mount on the neck top plate, +Z up -->
    <link name="torso_head_mount"/>
    <joint name="torso_head_mount_joint" type="fixed">
      <parent link="torso_frame"/>
      <child link="torso_head_mount"/>
      <origin xyz="0 0 0.648" rpy="0 0 0"/>
    </joint>

    <!-- Serving tray disc, resting on the support arms of the frame -->
    <xacro:if value="${left_accessory == 'tray'}">
      <link name="torso_tray">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.16" length="0.015"/>
          </geometry>
          <material name="torso_tray_silver">
            <color rgba="0.75 0.75 0.75 1"/>
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.16" length="0.015"/>
          </geometry>
        </collision>
        <xacro:cylinder_inertial_with_origin radius="0.16" length="0.015" mass="0.6">
          <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:cylinder_inertial_with_origin>
      </link>
      <joint name="torso_tray_joint" type="fixed">
        <parent link="torso_frame"/>
        <child link="torso_tray"/>
        <!-- disc bottom rests on the support arms' top face -->
        <origin xyz="0.15 0.30 0.60" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <!-- Head payload placeholders -->
    <xacro:if value="${head_accessory == 'screen'}">
      <link name="torso_screen">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="0.03 0.24 0.16"/>
          </geometry>
          <material name="torso_dark">
            <color rgba="0.12 0.12 0.12 1"/>
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="0.03 0.24 0.16"/>
          </geometry>
        </collision>
        <xacro:box_inertial_with_origin x="0.03" y="0.24" z="0.16" mass="0.5">
          <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:box_inertial_with_origin>
      </link>
      <joint name="torso_screen_joint" type="fixed">
        <parent link="torso_head_mount"/>
        <child link="torso_screen"/>
        <!-- slight backwards tilt so the screen faces a standing person -->
        <origin xyz="0.01 0 0.09" rpy="0 -0.15 0"/>
      </joint>
    </xacro:if>

    <xacro:if value="${head_accessory == 'sensor_head'}">
      <link name="torso_sensor_head">
        <visual>
          <origin xyz="0 0 0.05" rpy="0 0 0"/>
          <geometry>
            <box size="0.12 0.12 0.10"/>
          </geometry>
          <material name="torso_dark">
            <color rgba="0.12 0.12 0.12 1"/>
          </material>
        </visual>
        <!-- camera lens stub on the front face -->
        <visual>
          <origin xyz="0.065 0 0.05" rpy="0 ${pi/2} 0"/>
          <geometry>
            <cylinder radius="0.015" length="0.01"/>
          </geometry>
          <material name="torso_lens">
            <color rgba="0.05 0.05 0.2 1"/>
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0.05" rpy="0 0 0"/>
          <geometry>
            <box size="0.12 0.12 0.10"/>
          </geometry>
        </collision>
        <xacro:box_inertial_with_origin x="0.12" y="0.12" z="0.10" mass="0.5">
          <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </xacro:box_inertial_with_origin>
      </link>
      <joint name="torso_sensor_head_joint" type="fixed">
        <parent link="torso_head_mount"/>
        <child link="torso_sensor_head"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

  </xacro:macro>
</robot>
